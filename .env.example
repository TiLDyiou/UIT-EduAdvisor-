# ==========================================================================
# UIT EduAdvisor - Example environment variables
#
# Copy to .env and adjust for your environment:
#   cp .env.example .env
#
# Naming convention:
#   - APP_*         : settings shared by all services (env, log level)
#   - API_*         : FastAPI-specific (apps/api)
#   - WEB_*         : Next.js-specific (apps/web)
#   - POSTGRES_*    : Postgres container
#   - REDIS_*       : Redis container
#   - VAULT_*       : Vault container (dev-mode in M0)
#
# Secrets in this file are placeholders. Generate real ones before staging:
#   openssl rand -hex 32
# ==========================================================================

# --- Common ---
# One of: local | staging | production
APP_ENV=local
# One of: DEBUG | INFO | WARNING | ERROR
APP_LOG_LEVEL=INFO
TZ=Asia/Ho_Chi_Minh

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=54321
POSTGRES_DB=eduadvisor
POSTGRES_USER=eduadvisor
POSTGRES_PASSWORD=change-me-in-real-env

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=63791

# --- Vault (dev-mode in M0; switch to production mode in M1) ---
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN_ID=dev-only-root-token

# --- API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
# CORS origins, comma-separated
API_CORS_ORIGINS=http://localhost:3000

# --- M2: DAA / Moodle (real crawl; defaults target UIT portals) ---
DAA_BASE_URL=https://daa.uit.edu.vn
DAA_LOGIN_PATH=/user
DAA_PROFILE_PATH=/user
DAA_GRADES_PATH=/sinhvien/tracuu/kqht
DAA_SCHEDULE_PATH=/sinhvien/tkb
DAA_EXAMS_PATH=/sinhvien/tracuu/lichthi

MOODLE_BASE_URL=https://courses.uit.edu.vn
MOODLE_LOGIN_PATH=/login/index.php
MOODLE_CALENDAR_PATH=/calendar/view.php?view=upcoming

HTTP_USER_AGENT=UIT-EduAdvisor/0.1
HTTP_TIMEOUT_SECONDS=45

CAPTCHA_STATE_TTL_SECONDS=300
CAPTCHA_COOLDOWN_SECONDS=60
CAPTCHA_FAIL_THRESHOLD=3

STUDENT_SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=uea_session
# Set true behind HTTPS (staging/production). Must be false for plain http://localhost
SESSION_COOKIE_SECURE=false

DAA_CAPTCHA_RATE_LIMIT_PER_HOUR=30
DAA_LOGIN_RATE_LIMIT_PER_HOUR=10

# --- Web (Next.js) ---
# Server-side URL the web container uses to reach the API service
API_INTERNAL_URL=http://api:8000
# Browser URL for API calls. Use the Next.js origin so session cookies work via /api/v1 rewrite.
# --- M6: AI Mate (Gemini; keep keys out of source control in real env) ---
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.0-flash
AI_EMBEDDING_MODEL=text-embedding-004
AI_CHAT_RATE_LIMIT_PER_HOUR=30
AI_CHAT_TIMEOUT_SECONDS=60
AI_STREAM_FIRST_BYTE_SECONDS=3
AI_SUMMARY_RETENTION_DAYS=90
AI_PUBLIC_POLICY_RETRIEVE_PER_HOUR=120
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- M7: Remote Bot (leave empty to run in mock mode; see docs/M7_BOT_INTEGRATION_GUIDE.md) ---
# Discord Bot
DISCORD_BOT_TOKEN=
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=
MESSENGER_APP_SECRET=
MESSENGER_PAGE_NAME=
BOT_COMMAND_RATE_LIMIT_PER_HOUR=10
BOT_LINK_TOKEN_TTL_SECONDS=600
REMINDER_CHECK_INTERVAL_SECONDS=300
REMINDER_EXAM_HOURS_BEFORE=36
REMINDER_DEADLINE_HOURS_BEFORE=18

# --- Email / SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=False

