# ==========================================================================
# UIT EduAdvisor - Example environment variables
#
# Copy to .env and adjust for your environment:
#   cp .env.example .env
#
# Naming convention:
#   - APP_*         : settings shared by all services (env, log level)
#   - API_*         : FastAPI-specific (apps/api)
#   - WEB_*         : Next.js-specific (apps/web)
#   - POSTGRES_*    : Postgres container
#   - REDIS_*       : Redis container
#   - VAULT_*       : Vault container (dev-mode in M0)
#
# Secrets in this file are placeholders. Generate real ones before staging:
#   openssl rand -hex 32
# ==========================================================================

# --- Common ---
# One of: local | staging | production
APP_ENV=local
# One of: DEBUG | INFO | WARNING | ERROR
APP_LOG_LEVEL=INFO
TZ=Asia/Ho_Chi_Minh

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=eduadvisor
POSTGRES_USER=eduadvisor
POSTGRES_PASSWORD=change-me-in-real-env

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Vault (dev-mode in M0; switch to production mode in M1) ---
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN_ID=dev-only-root-token

# --- API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
# CORS origins, comma-separated
API_CORS_ORIGINS=http://localhost:3000

# --- Web (Next.js) ---
# Server-side URL the web container uses to reach the API service
API_INTERNAL_URL=http://api:8000
# Browser-facing URL exposed by docker-compose port mapping
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000
